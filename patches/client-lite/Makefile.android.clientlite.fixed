# Android CLIENT_LITE Makefile - Fixed paths and submodule handling
# Only builds core P2P storage functionality

# Paths relative to this Makefile's location
LOGOS_STORAGE_SRC := ../logos-storage-nim
PATCH_DIR := $(dir $(lastword $(MAKEFILE_LIST)))

# Android NDK configuration
NDK_ROOT ?= $(HOME)/Android/Sdk/ndk/29.0.14206865
HOST_TRIPLE ?= aarch64-unknown-linux-android

# Android toolchain paths
NDK_TARGET := $(NDK_ROOT)/toolchains/llvm/prebuilt/linux-x86_64
CC := $(NDK_TARGET)/bin/aarch64-linux-android21-clang
CXX := $(NDK_TARGET)/bin/aarch64-linux-android21-clang++
AR := $(NDK_TARGET)/bin/llvm-ar

# Build flags for Android ARM64
CFLAGS := -Os -fPIC -target aarch64-linux-android21
LDFLAGS := 

# CLIENT_LITE mode - only build essential P2P components
ANDROID_DEPS := libnatpmp.a

.PHONY: deps-android libstorage-androidlite clean-android

# Android-only dependencies (minimal set for client-lite)
deps-android: init-submodules $(ANDROID_DEPS)
	@echo "Android CLIENT_LITE dependencies built: $(ANDROID_DEPS)"

# Initialize essential git submodules for CLIENT_LITE
init-submodules:
	@echo "Initializing essential git submodules for Android CLIENT_LITE..."
	@cd $(LOGOS_STORAGE_SRC) && git submodule update --init --recursive vendor/logos-storage-nim-dht
	@cd $(LOGOS_STORAGE_SRC) && git submodule update --init --recursive vendor/nim-nat-traversal
	@cd $(LOGOS_STORAGE_SRC) && git submodule update --init --recursive vendor/nim-bearssl
	@cd $(LOGOS_STORAGE_SRC) && git submodule update --init --recursive vendor/nim-stew
	@cd $(LOGOS_STORAGE_SRC) && git submodule update --init --recursive vendor/nim-chronicles
	@cd $(LOGOS_STORAGE_SRC) && git submodule update --init --recursive vendor/nim-chronos
	@cd $(LOGOS_STORAGE_SRC) && git submodule update --init --recursive vendor/nim-ethers || true
	@cd $(LOGOS_STORAGE_SRC) && git submodule update --init --recursive vendor/nim-confutils || true
	@cd $(LOGOS_STORAGE_SRC) && git submodule update --init --recursive vendor/nim-metrics || true
	@cd $(LOGOS_STORAGE_SRC) && git submodule update --init --recursive vendor/questionable || true
	@cd $(LOGOS_STORAGE_SRC) && git submodule update --init --recursive vendor/presto || true
	@echo "✓ Essential submodules initialized for Android CLIENT_LITE"

# Build NAT traversal for Android
libnatpmp.a:
	@echo "Building libnatpmp for Android ARM64..."
	@cd $(LOGOS_STORAGE_SRC)/vendor/nim-nat-traversal/vendor/libnatpmp-upstream && \
	CC=$(CC) AR=$(AR) CFLAGS="$(CFLAGS)" \
	make libnatpmp.a
	@echo "✓ libnatpmp.a built for Android"

# Build CLIENT_LITE libstorage for Android (no REST API)
libstorage-androidlite: deps-android
	@echo "Building CLIENT_LITE libstorage for Android ARM64..."
	@export PATH="/home/lowkey/.nimble/bin:/home/lowkey/.choosenim/toolchains/nim-2.2.8/bin:$$PATH" && \
	export CLIENT_LITE=1 && \
	export STATIC=1 && \
	export HOST_TRIPLE=$(HOST_TRIPLE) && \
	export CC=$(CC) && \
	export CXX=$(CXX) && \
	export AR=$(AR) && \
	export NIM_PARAMS="-d:CLIENT_LITE -d:disable_libbacktrace" && \
	export LIBSTORAGE_PARAMS="-d:CLIENT_LITE -d:disable_libbacktrace" && \
	cd $(LOGOS_STORAGE_SRC) && nim c \
		--out:build/libstorage.a \
		--threads:on \
		--app:staticlib \
		--opt:size \
		--noMain \
		--mm:refc \
		--header \
		--nimMainPrefix:libstorage \
		--d:noSignalHandler \
		--d:chronicles_runtime_filtering \
		--d:chronicles_log_level=ERROR \
		--verbosity:0 \
		--hints:off \
		--d:release \
		--d:CLIENT_LITE \
		--d:disable_libbacktrace \
		library/libstorage.nim
	@echo "✓ CLIENT_LITE libstorage built for Android"
	@echo "Output: build/libstorage.a (SQLite-only, no REST API)"

# Clean Android build artifacts
clean-android:
	@echo "Cleaning Android CLIENT_LITE build artifacts..."
	@rm -f $(LOGOS_STORAGE_SRC)/build/libstorage.a
	@cd $(LOGOS_STORAGE_SRC)/vendor/nim-nat-traversal/vendor/libnatpmp-upstream && make clean || true
	@echo "✓ Android CLIENT_LITE cleanup complete"