# Android CLIENT_LITE Makefile - Excludes REST API entirely
# Only builds core P2P storage functionality

# Android NDK configuration
NDK_ROOT ?= $(HOME)/Android/Sdk/ndk/29.0.14206865
HOST_TRIPLE ?= aarch64-unknown-linux-android

# Android toolchain paths
NDK_TARGET := $(NDK_ROOT)/toolchains/llvm/prebuilt/linux-x86_64
CC := $(NDK_TARGET)/bin/aarch64-linux-android21-clang
CXX := $(NDK_TARGET)/bin/aarch64-linux-android21-clang++
AR := $(NDK_TARGET)/bin/llvm-ar

# Build flags for Android ARM64
CFLAGS := -Os -fPIC -target aarch64-linux-android21
LDFLAGS := 

# CLIENT_LITE mode - only build essential P2P components
ANDROID_DEPS := libnatpmp.a

.PHONY: deps-android libstorage-androidlite clean-android

# Android-only dependencies (minimal set for client-lite)
deps-android: init-submodules $(ANDROID_DEPS)
	@echo "Android CLIENT_LITE dependencies built: $(ANDROID_DEPS)"

# Initialize essential git submodules for CLIENT_LITE
init-submodules:
	@echo "Initializing ALL git submodules for Android CLIENT_LITE..."
	+ cd ../logos-storage-nim && git submodule update --init --recursive
	@echo "✓ All submodules initialized for Android CLIENT_LITE"

# Build NAT traversal for Android
libnatpmp.a:
	@echo "Building libnatpmp for Android ARM64..."
	cd ../logos-storage-nim/vendor/nim-nat-traversal/vendor/libnatpmp-upstream && \
	CC=$(CC) AR=$(AR) CFLAGS="$(CFLAGS)" \
	make libnatpmp.a
	@echo "✓ libnatpmp.a built for Android"

# Build CLIENT_LITE libstorage for Android (no REST API)
libstorage-androidlite: deps-android
	@echo "Building CLIENT_LITE libstorage for Android ARM64..."
	@echo "Using CC: $(CC)"
	@echo "Using CXX: $(CXX)"
	@echo "Using AR: $(AR)"
	@echo "Using HOST_TRIPLE: $(HOST_TRIPLE)"
	export CLIENT_LITE=1 && \
	export STATIC=1 && \
	export HOST_TRIPLE=$(HOST_TRIPLE) && \
	export CC=$(CC) && \
	export CXX=$(CXX) && \
	export AR=$(AR) && \
	export NIM_PARAMS="-d:CLIENT_LITE -d:disable_libbacktrace" && \
	export LIBSTORAGE_PARAMS="-d:CLIENT_LITE -d:disable_libbacktrace" && \
	cd ../logos-storage-nim && nim c \
		--cpu:arm64 \
		--os:android \
		--cc:clang \
		--clang.linker.exe:clang \
		--clang.linker.exe:clang++ \
		--ar.exe:llvm-ar \
		--path:vendor \
		--path:vendor/nim-taskpools \
		--path:vendor/nim-chronicles \
		--path:vendor/nim-chronos \
		--path:vendor/logos-storage-nim-dht \
		--path:vendor/nim-libp2p \
		--path:vendor/nim-confutils \
		--path:vendor/nim-stew \
		--path:vendor/nim-datastore \
		--path:vendor/nim-eth \
		--path:vendor/nim-ethers \
		--path:vendor/nim-bearssl \
		--path:vendor/nim-metrics \
		--path:vendor/questionable \
		--path:vendor/nim-presto \
		--path:vendor/nim-secp256k1 \
		--path:vendor/nimcrypto \
		--path:vendor/nim-nat-traversal \
		--path:vendor/nim-asyncutils \
		--path:vendor/nim-faststreams \
		--path:vendor/nim-serialization \
		--path:vendor/nim-blscurve \
		--path:vendor/constantine \
		--path:vendor/nim-contract-abi \
		--path:vendor/nim-websock \
		--path:vendor/nim-toml-serialization \
		--path:vendor/stint \
		--path:vendor/nim-serde \
		--out:build/libstorage.a \
		--threads:on \
		--app:staticlib \
		--opt:size \
		--noMain \
		--mm:refc \
		--header \
		--d:metrics \
		--nimMainPrefix:libstorage \
		--d:noSignalHandler \
		--d:chronicles_runtime_filtering \
		--d:chronicles_log_level=ERROR \
		--verbosity:2 \
		--hints:off \
		--d:release \
		--d:CLIENT_LITE \
		--d:disable_libbacktrace \
		library/libstorage.nim
	@echo "✓ CLIENT_LITE libstorage built for Android"
	@echo "Output: build/libstorage.a (SQLite-only, no REST API)"

# Clean Android build artifacts
clean-android:
	@echo "Cleaning Android CLIENT_LITE build artifacts..."
	rm -f ../logos-storage-nim/build/libstorage.a
	cd ../logos-storage-nim/vendor/nim-nat-traversal/vendor/libnatpmp-upstream && make clean || true
	@echo "✓ Android CLIENT_LITE cleanup complete"