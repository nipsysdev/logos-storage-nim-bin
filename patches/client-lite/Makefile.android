# Android-specific Makefile for logos-storage-nim
# Optimized for CLIENT_LITE builds (SQLite only, no LevelDB)

# Android NDK configuration
NDK_ROOT ?= $(HOME)/Android/Sdk/ndk/29.0.14206865
HOST_TRIPLE ?= aarch64-unknown-linux-android

# Android toolchain paths
NDK_TARGET := $(NDK_ROOT)/toolchains/llvm/prebuilt/linux-x86_64
CC := $(NDK_TARGET)/bin/aarch64-linux-android21-clang
CXX := $(NDK_TARGET)/bin/aarch64-linux-android21-clang++
AR := $(NDK_TARGET)/bin/llvm-ar

# Build flags for Android ARM64
CFLAGS := -Os -fPIC -target aarch64-linux-android21
LDFLAGS := 

# CLIENT_LITE mode - only build essential dependencies
# Skip: libbacktrace (problematic on Android) and libupnp (may not be needed)
ANDROID_DEPS := libnatpmp.a

# Debug info
ANDROID_DEPS_DEBUG := $(ANDROID_DEPS)

.PHONY: deps-android libstorage-android clean-android test-android

# Android-only dependencies (minimal set)
deps-android: init-submodules $(ANDROID_DEPS)
	@echo "Android CLIENT_LITE dependencies built: $(ANDROID_DEPS_DEBUG)"

# Initialize essential submodules for CLIENT_LITE
init-submodules:
	@echo "Initializing essential git submodules for Android..."
	+ git submodule update --init --recursive vendor/logos-storage-nim-dht
	+ git submodule update --init --recursive vendor/nim-nat-traversal
	+ git submodule update --init --recursive vendor/nim-bearssl
	+ git submodule update --init --recursive vendor/nim-stew
	+ git submodule update --init --recursive vendor/nim-chronicles
	+ git submodule update --init --recursive vendor/nim-chronos
	+ git submodule update --init --recursive vendor/nim-coreutils || true
	@echo "✓ Essential submodules initialized for Android"

# Build NAT-PMP library for Android (needed for P2P)
libnatpmp.a: | sanity-checks
	@echo "Building libnatpmp for Android ARM64..."
	+ cd vendor/nim-nat-traversal/vendor/libnatpmp-upstream && \
		CC=$(CC) AR=$(AR) CFLAGS="$(CFLAGS)" \
		$(MAKE) libnatpmp.a
	@echo "✓ libnatpmp.a built for Android"

# Android dependencies target
deps: init-submodules libnatpmp.a
	@echo "✓ Android dependencies built"

# Sanity checks for Android build
sanity-checks:
	@echo "Checking Android build environment..."
	@if [ ! -f "$(CC)" ]; then \
		echo "ERROR: Android compiler not found: $(CC)"; \
		exit 1; \
	fi
	@if [ ! -f "$(AR)" ]; then \
		echo "ERROR: Android archiver not found: $(AR)"; \
		exit 1; \
	fi
	@if [ ! -d "vendor/nim-nat-traversal" ]; then \
		echo "ERROR: nim-nat-traversal submodule not found"; \
		exit 1; \
	fi
	@echo "✓ Android build environment validated"

# Build libstorage for Android with CLIENT_LITE
libstorage-android: init-submodules 
	@echo "Building libstorage for Android CLIENT_LITE..."
	export PATH="/home/lowkey/.nimble/bin:/home/lowkey/.choosenim/toolchains/nim-2.2.8/bin:$$PATH" && \
	export CLIENT_LITE=1 && \
	export STATIC=1 && \
	export HOST_TRIPLE=$(HOST_TRIPLE) && \
	export CC=$(CC) && \
	export CXX=$(CXX) && \
	export AR=$(AR) && \
	export NIM_PARAMS="-d:CLIENT_LITE -d:disable_libbacktrace" && \
	export LIBSTORAGE_PARAMS="-d:CLIENT_LITE -d:disable_libbacktrace" && \
	make deps USE_SYSTEM_NIM=1 && \
	nim c \
		--out:build/libstorage.a \
		--threads:on \
		--app:staticlib \
		--opt:size \
		--noMain \
		--mm:refc \
		--header \
		--d:metrics \
		--nimMainPrefix:libstorage \
		--d:noSignalHandler \
		--d:chronicles_runtime_filtering \
		--d:chronicles_log_level=TRACE \
		--verbosity:0 \
		--hints:off \
		--d:release \
		--d:CLIENT_LITE \
		--d:disable_libbacktrace \
		library/libstorage.nim
	@echo "✓ Android libstorage.a built successfully"

# Clean Android artifacts
clean-android:
	@echo "Cleaning Android build artifacts..."
	rm -f build/libstorage.a
	rm -f vendor/nim-nat-traversal/vendor/libnatpmp-upstream/libnatpmp.a
	@echo "✓ Android cleanup complete"

# Test Android build
test-android: libstorage-android
	@echo "Testing Android build..."
	@if [ -f "build/libstorage.a" ]; then \
		echo "✓ Android libstorage.a exists"; \
		file build/libstorage.a; \
		echo "✓ Android build test passed"; \
	else \
		echo "✗ Android build test failed - libstorage.a not found"; \
		exit 1; \
	fi

# Help target
help:
	@echo "Android CLIENT_LITE Makefile targets:"
	@echo "  deps-android     - Build Android dependencies only"
	@echo "  libstorage-android - Build libstorage for Android"
	@echo "  clean-android    - Clean Android artifacts"
	@echo "  test-android     - Test Android build"