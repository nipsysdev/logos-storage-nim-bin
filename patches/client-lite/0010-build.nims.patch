diff --git a/build.nims b/build.nims
index b74a931f..5a7c7b3b 100644
--- a/build.nims
+++ b/build.nims
@@ -38,6 +38,60 @@ proc buildBinary(
 proc buildLibrary(name: string, srcDir = "./", params = "", `type` = "dynamic") =
   if not dirExists "build":
     mkDir "build"
+  
+  var extra_params = params
+
+  # Android-specific compiler flags
+  when defined(android):
+    let android_cc = getEnv("CODEX_ANDROID_CC")
+    let android_ndk = getEnv("ANDROID_NDK_HOME")
+    let android_clang_version = getEnv("ANDROID_CLANG_VERSION")
+    let target_arch = getEnv("TARGET_ARCH", "arm64")
+    
+    # Disable x86-64 assembly for secp256k1 on ARM64 builds
+    if target_arch == "arm64":
+      extra_params &= " --define:SECP256K1_NO_ASM"
+      extra_params &= " --define:USE_ASM_X86_64=0"
+    let android_linker = android_ndk & "/toolchains/llvm/prebuilt/linux-x86_64/bin/ld.lld"
+    let android_omp_lib = android_ndk & "/toolchains/llvm/prebuilt/linux-x86_64/lib/clang/" & android_clang_version & "/lib/linux/" & target_arch
+    let android_sysroot = android_ndk & "/toolchains/llvm/prebuilt/linux-x86_64/sysroot"
+    let android_lib_path = android_sysroot & "/usr/lib/" & target_arch & "-linux-android"
+    let android_lib_path21 = android_lib_path & "/21"
+    let android_lib_path31 = android_lib_path & "/31"
+    let android_clang_lib = android_ndk & "/toolchains/llvm/prebuilt/linux-x86_64/lib/clang/" & android_clang_version & "/lib/linux"
+    let android_builtins = android_clang_lib & "/libclang_rt.builtins-" & target_arch & "-android.a"
+    let android_crtbegin = android_lib_path21 & "/crtbegin_so.o"
+    let android_crtend = android_lib_path21 & "/crtend_so.o"
+
+    # Convert x86_64 to amd64 for Nim compiler, but ensure ARM64 is correctly detected
+    let nim_cpu = if target_arch == "x86_64": "amd64"
+                  elif target_arch == "aarch64": "arm64"
+                  else: target_arch
+    extra_params &= " --cpu:" & nim_cpu & " --os:android --cc:clang --clang.execlang=" & android_cc
+    
+    # Additional flags to prevent x86 intrinsics on ARM64 Android
+    if target_arch == "aarch64":
+      extra_params &= " --define:arm64 --define:noX86Intrinsics --define:noSimd --define:noInlineAsm"
+    # Add C compiler flags to prevent x86 intrinsics on ARM64
+    if target_arch == "aarch64":
+      extra_params &= " --passC:-D__ARM_ARCH --passC:-U__x86_64__ --passC:-U__i386__ --passC:-Uamd64 --passC:-D__aarch64__ --passC:-U__i686__"
+    
+    extra_params &= " --passl:-fuse-ld=" & android_linker
+    extra_params &= " --passl:-L" & android_omp_lib
+    extra_params &= " --passl:-L" & android_clang_lib
+    extra_params &= " --passl:-L" & android_lib_path
+    extra_params &= " --passl:-L" & android_lib_path21
+    extra_params &= " --passl:-L" & android_lib_path31
+    extra_params &= " --passl:-nostdlib"
+    extra_params &= " --passl:" & android_crtbegin
+    extra_params &= " --passl:" & android_crtend
+    extra_params &= " --passl:" & android_builtins
+    extra_params &= " --passl:-lc"
+    extra_params &= " --passl:-lm"
+    extra_params &= " --passl:-ldl"
+    extra_params &= " --passl:-Wl,--allow-multiple-definition"
+    extra_params &= " --passl:-Wl,--undefined-version"
+    extra_params &= " --passl:--target=" & target_arch & "-linux-android21"
 
   if `type` == "dynamic":
     let lib_name = (
@@ -146,6 +200,18 @@ task libstorageDynamic, "Generate bindings":
       if param.len > 0 and param.startsWith("-"):
         params.add " " & param
 
+  # Android-specific parameters
+  when defined(android):
+    if existsEnv("ANDROID_DEFINES"):
+      params.add " " & getEnv("ANDROID_DEFINES")
+    
+    # Disable x86-64 assembly for secp256k1 on ARM64 builds
+    let android_target_arch = getEnv("TARGET_ARCH", "arm64")
+    if android_target_arch == "arm64":
+      params.add " --define:SECP256K1_NO_ASM"
+      params.add " --define:USE_ASM_X86_64=0"
+    
+
   let name = "libstorage"
   buildLibrary name, "library/", params, "dynamic"
 
@@ -155,6 +221,17 @@ task libstorageStatic, "Generate bindings":
     for param in commandLineParams():
       if param.len > 0 and param.startsWith("-"):
         params.add " " & param
+  
+  # Android-specific parameters
+  when defined(android):
+    if existsEnv("ANDROID_DEFINES"):
+      params.add " " & getEnv("ANDROID_DEFINES")
+    
+    # Disable x86-64 assembly for secp256k1 on ARM64 builds
+    let android_target_arch = getEnv("TARGET_ARCH", "arm64")
+    if android_target_arch == "arm64":
+      params.add " --define:SECP256K1_NO_ASM"
+      params.add " --define:USE_ASM_X86_64=0"
 
   let name = "libstorage"
   buildLibrary name, "library/", params, "static"
